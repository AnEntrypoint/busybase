`bun run src/cli.ts serve` | `bun build src/server.ts --target=bun --outfile=src/server.js --external @libsql/client && bun build src/sdk.ts --target=browser --format=esm --outfile=src/sdk.js && bun build src/cli.ts --target=bun --outfile=src/cli.js --external @libsql/client && bun build src/embedded.ts --target=bun --outfile=src/embedded.js --external @libsql/client && bun build src/hooks.ts --target=bun --outfile=src/hooks.js --external @libsql/client && bun build src/realtime.ts --target=bun --outfile=src/realtime.js --external @libsql/client` | `bun run src/cli.ts test`

